<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Internal reference sequence: LKW-YYYY-NNNNN -->
        <!-- Séquence de référence interne : LKW-YYYY-NNNNN -->
        <record id="seq_legal_knowledge_document" model="ir.sequence">
            <field name="name">Legal Knowledge Document Reference</field>
            <field name="code">legal.knowledge.document</field>
            <field name="prefix">LKW-%(year)s-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
