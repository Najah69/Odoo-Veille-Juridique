<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Odoo 18: ir.cron no longer carries model/code/state directly,
             it delegates execution to an ir.actions.server record. -->
        <record id="ir_action_server_legal_watch_fetch" model="ir.actions.server">
            <field name="name">Legal Knowledge Watch: Fetch due watches</field>
            <field name="model_id" ref="model_legal_watch"/>
            <field name="state">code</field>
            <field name="code">model._cron_fetch_due_watches()</field>
        </record>

        <record id="ir_cron_legal_watch_fetch" model="ir.cron">
            <field name="cron_name">Legal Knowledge Watch: Fetch due watches</field>
            <field name="ir_actions_server_id" ref="ir_action_server_legal_watch_fetch"/>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

    </data>
</odoo>
