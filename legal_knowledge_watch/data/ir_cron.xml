<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Odoo 18: ir.cron no longer carries model/code/state directly,
             it delegates execution to an ir.actions.server record. -->
        <record id="ir_action_server_legal_watch_fetch" model="ir.actions.server">
            <field name="name">Legal Knowledge Watch: Fetch due watches</field>
            <field name="model_id" ref="model_legal_watch"/>
            <field name="state">code</field>
            <field name="code">model._cron_fetch_due_watches()</field>
        </record>

        <record id="ir_cron_legal_watch_fetch" model="ir.cron">
            <field name="cron_name">Legal Knowledge Watch: Fetch due watches</field>
            <field name="ir_actions_server_id" ref="ir_action_server_legal_watch_fetch"/>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <record id="ir_action_server_legal_ai_jobs" model="ir.actions.server">
            <field name="name">Legal Knowledge Watch: Process AI jobs</field>
            <field name="model_id" ref="model_legal_ai_job"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_pending_jobs()</field>
        </record>

        <record id="ir_cron_legal_ai_jobs" model="ir.cron">
            <field name="cron_name">Legal Knowledge Watch: Process AI jobs</field>
            <field name="ir_actions_server_id" ref="ir_action_server_legal_ai_jobs"/>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <record id="ir_action_server_legal_reconcile" model="ir.actions.server">
            <field name="name">Legal Knowledge Watch: Reconcile</field>
            <field name="model_id" ref="model_legal_knowledge_document"/>
            <field name="state">code</field>
            <field name="code">model._cron_reconcile_exports()</field>
        </record>

        <record id="ir_cron_legal_reconcile" model="ir.cron">
            <field name="cron_name">Legal Knowledge Watch: Reconcile</field>
            <field name="ir_actions_server_id" ref="ir_action_server_legal_reconcile"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <!-- Disabled by default: retention purges data. Enabling this cron
             runs it in dry_run mode only (logs what would happen, writes
             nothing) — a real run requires an explicit
             model._cron_apply_retention(dry_run=False) call, e.g. from a
             one-off scheduled action or the Odoo shell, never silently. -->
        <record id="ir_action_server_legal_retention" model="ir.actions.server">
            <field name="name">Legal Knowledge Watch: Apply Retention (dry run)</field>
            <field name="model_id" ref="model_legal_knowledge_document"/>
            <field name="state">code</field>
            <field name="code">model._cron_apply_retention(dry_run=True)</field>
        </record>

        <record id="ir_cron_legal_retention" model="ir.cron">
            <field name="cron_name">Legal Knowledge Watch: Apply Retention (dry run)</field>
            <field name="ir_actions_server_id" ref="ir_action_server_legal_retention"/>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active" eval="False"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

    </data>
</odoo>
