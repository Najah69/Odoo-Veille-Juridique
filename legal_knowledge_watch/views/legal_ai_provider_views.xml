<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_legal_ai_provider_list" model="ir.ui.view">
        <field name="name">legal.ai.provider.list</field>
        <field name="model">legal.ai.provider</field>
        <field name="arch" type="xml">
            <list string="AI/Export Providers">
                <field name="name"/>
                <field name="provider_type"/>
                <field name="base_url"/>
                <field name="enabled_for_classification"/>
                <field name="enabled_for_export"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_legal_ai_provider_form" model="ir.ui.view">
        <field name="name">legal.ai.provider.form</field>
        <field name="model">legal.ai.provider</field>
        <field name="arch" type="xml">
            <form string="AI/Export Provider">
                <header>
                    <button name="action_healthcheck" type="object" string="Healthcheck"
                            groups="legal_knowledge_watch.group_legal_watch_administrator"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="provider_type"/>
                            <field name="base_url"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="enabled_for_classification"/>
                            <field name="enabled_for_export"/>
                            <field name="timeout_seconds"/>
                            <field name="verify_tls"/>
                        </group>
                    </group>
                    <group string="Authentication">
                        <field name="auth_mode"/>
                        <field name="auth_header_name" invisible="auth_mode != 'header'"/>
                        <field name="secret_parameter_key" invisible="auth_mode == 'none'"/>
                        <p class="text-muted" invisible="auth_mode == 'none'">
                            Never enter the secret's value here. Set it via the
                            LKW_&lt;DERIVED_FROM_KEY&gt;_TOKEN environment variable
                            (preferred) or Settings &gt; Technical &gt; System
                            Parameters, using the key above. See docs/ai-providers.md.
                        </p>
                    </group>
                    <group string="Configuration (JSON)">
                        <field name="configuration_json" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_legal_ai_provider" model="ir.actions.act_window">
        <field name="name">AI/Export Providers</field>
        <field name="res_model">legal.ai.provider</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
