<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="legal_watch_reader_page" name="Veille juridique — Lecture">
        <t t-call="website.layout">
            <div class="container py-5" style="max-width: 900px;">
                <div class="d-flex justify-content-between align-items-start mb-1 gap-3">
                    <h1 class="fw-bold mb-0">📚 Veille juridique</h1>
                    <a t-if="settings_action_id" t-attf-href="/odoo/action-#{settings_action_id}"
                       class="btn btn-outline-secondary btn-sm flex-shrink-0 mt-2"
                       title="Paramètres des veilles">
                        ⚙️
                    </a>
                </div>
                <p class="text-muted mb-4">
                    Revue de presse — toutes sources confondues, les plus récents en premier.
                </p>

                <div t-if="not rows" class="text-center text-muted py-5">
                    Aucun document pour l'instant.
                </div>

                <t t-foreach="rows" t-as="row">
                    <t t-set="doc" t-value="row[0]"/>
                    <t t-set="badge_class" t-value="row[1]"/>
                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2 gap-3">
                                <h5 class="card-title mb-0">
                                    <a t-if="doc.canonical_url" t-att-href="doc.canonical_url"
                                       target="_blank" class="text-decoration-none text-dark">
                                        <t t-esc="doc.name"/>
                                    </a>
                                    <t t-else="">
                                        <t t-esc="doc.name"/>
                                    </t>
                                </h5>
                                <span t-attf-class="badge #{badge_class} flex-shrink-0">
                                    <t t-esc="doc.status"/>
                                </span>
                            </div>
                            <div class="text-muted small mb-2">
                                <t t-esc="doc.source_id.name"/>
                                <t t-if="doc.published_at">
                                    · <t t-esc="doc.published_at.strftime('%d/%m/%Y')"/>
                                </t>
                            </div>
                            <p class="mb-0" style="white-space: pre-line;">
                                <t t-esc="(doc.current_version_text or '')[:preview_length]"/>
                                <t t-if="doc.current_version_text and len(doc.current_version_text) > preview_length">…</t>
                            </p>
                        </div>
                    </div>
                </t>
            </div>
        </t>
    </template>

</odoo>
