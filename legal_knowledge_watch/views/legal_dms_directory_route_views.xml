<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_legal_dms_directory_route_list" model="ir.ui.view">
        <field name="name">legal.dms.directory.route.list</field>
        <field name="model">legal.dms.directory.route</field>
        <field name="arch" type="xml">
            <list string="DMS Directory Routing" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="tag_id"/>
                <field name="company_id"/>
                <field name="dms_directory_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_legal_dms_directory_route" model="ir.actions.act_window">
        <field name="name">DMS Directory Routing</field>
        <field name="res_model">legal.dms.directory.route</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Requires OCA DMS. Route documents to a dms.directory by tag
                (leave the tag empty for a company's default/catch-all
                directory). See docs/oca-dms-integration.md.
            </p>
        </field>
    </record>

</odoo>
