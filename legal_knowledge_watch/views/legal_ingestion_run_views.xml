<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_legal_ingestion_run_list" model="ir.ui.view">
        <field name="name">legal.ingestion.run.list</field>
        <field name="model">legal.ingestion.run</field>
        <field name="arch" type="xml">
            <list string="Ingestion Runs" create="false"
                  decoration-danger="state == 'failed'"
                  decoration-warning="state == 'partial'"
                  decoration-success="state == 'success'">
                <field name="started_at"/>
                <field name="watch_id"/>
                <field name="source_id"/>
                <field name="trigger"/>
                <field name="state"/>
                <field name="fetched_count"/>
                <field name="created_count"/>
                <field name="updated_count"/>
                <field name="duplicate_count"/>
                <field name="filtered_count"/>
                <field name="error_count"/>
            </list>
        </field>
    </record>

    <record id="view_legal_ingestion_run_form" model="ir.ui.view">
        <field name="name">legal.ingestion.run.form</field>
        <field name="model">legal.ingestion.run</field>
        <field name="arch" type="xml">
            <form string="Ingestion Run" create="false">
                <sheet>
                    <group>
                        <group>
                            <field name="watch_id"/>
                            <field name="source_id"/>
                            <field name="trigger"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="started_at"/>
                            <field name="finished_at"/>
                        </group>
                    </group>
                    <group string="Counters">
                        <field name="fetched_count"/>
                        <field name="created_count"/>
                        <field name="updated_count"/>
                        <field name="duplicate_count"/>
                        <field name="filtered_count"/>
                        <field name="error_count"/>
                    </group>
                    <group string="Diagnostics">
                        <field name="log_excerpt" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_legal_ingestion_run" model="ir.actions.act_window">
        <field name="name">Ingestion Runs</field>
        <field name="res_model">legal.ingestion.run</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
