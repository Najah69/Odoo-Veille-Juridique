<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_legal_document_list" model="ir.ui.view">
        <field name="name">legal.knowledge.document.list</field>
        <field name="model">legal.knowledge.document</field>
        <field name="arch" type="xml">
            <list string="Legal Knowledge Documents"
                  decoration-muted="status in ('archived', 'rejected')"
                  decoration-info="status == 'review'"
                  decoration-success="status == 'approved'">
                <field name="reference"/>
                <field name="name"/>
                <field name="source_id"/>
                <field name="document_type"/>
                <field name="status"/>
                <field name="collected_at"/>
                <field name="needs_review"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_legal_document_form" model="ir.ui.view">
        <field name="name">legal.knowledge.document.form</field>
        <field name="model">legal.knowledge.document</field>
        <field name="arch" type="xml">
            <form string="Legal Knowledge Document">
                <header>
                    <button name="action_set_review" type="object" string="Send to Review"
                            invisible="status not in ('new', 'qualified')"
                            groups="legal_knowledge_watch.group_legal_watch_reviewer"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="oe_highlight"
                            invisible="status not in ('qualified', 'review')"
                            groups="legal_knowledge_watch.group_legal_watch_reviewer"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="status not in ('new', 'qualified', 'review')"
                            groups="legal_knowledge_watch.group_legal_watch_reviewer"/>
                    <button name="action_archive_document" type="object" string="Archive"
                            invisible="status not in ('approved', 'rejected', 'superseded')"
                            groups="legal_knowledge_watch.group_legal_watch_reviewer"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="new,qualified,review,approved"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_versions" type="object"
                                class="oe_stat_button" icon="fa-history">
                            <field name="version_count" widget="statinfo" string="Versions"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                        <span class="text-muted"><field name="reference" readonly="1"/></span>
                    </div>
                    <group>
                        <group>
                            <field name="source_id"/>
                            <field name="watch_id"/>
                            <field name="tag_ids" widget="many2many_tags"/>
                            <field name="needs_review"/>
                        </group>
                        <group>
                            <field name="document_type"/>
                            <field name="jurisdiction"/>
                            <field name="language"/>
                            <field name="relevance_score"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Source">
                            <group>
                                <group>
                                    <field name="external_id"/>
                                    <field name="source_url" widget="url"/>
                                    <field name="canonical_url" widget="url"/>
                                    <field name="authority"/>
                                </group>
                                <group>
                                    <field name="published_at"/>
                                    <field name="collected_at"/>
                                    <field name="last_checked_at"/>
                                    <field name="content_hash"/>
                                </group>
                            </group>
                        </page>
                        <page string="Content">
                            <group>
                                <field name="current_version_id" readonly="1"/>
                                <field name="attachment_id" readonly="1"/>
                            </group>
                            <field name="current_version_text" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Metadata">
                            <field name="source_metadata_json" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_legal_document" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">legal.knowledge.document</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
