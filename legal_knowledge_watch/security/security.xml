<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="module_category_legal_knowledge_watch" model="ir.module.category">
            <field name="name">Legal Knowledge Watch</field>
            <field name="sequence">20</field>
        </record>

        <!-- Groups, from least to most privileged -->
        <!-- Groupes, du moins au plus privilégié -->
        <record id="group_legal_watch_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_legal_knowledge_watch"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_legal_watch_reviewer" model="res.groups">
            <field name="name">Reviewer</field>
            <field name="category_id" ref="module_category_legal_knowledge_watch"/>
            <field name="implied_ids" eval="[(4, ref('group_legal_watch_user'))]"/>
        </record>

        <record id="group_legal_watch_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_legal_knowledge_watch"/>
            <field name="implied_ids" eval="[(4, ref('group_legal_watch_reviewer'))]"/>
        </record>

        <record id="group_legal_watch_administrator" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_legal_knowledge_watch"/>
            <field name="implied_ids" eval="[(4, ref('group_legal_watch_manager'))]"/>
        </record>

        <!-- Multi-company record rules -->
        <!-- Règles multi-société -->
        <record id="legal_watch_company_rule" model="ir.rule">
            <field name="name">legal.watch: multi-company</field>
            <field name="model_id" ref="model_legal_watch"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="legal_knowledge_document_company_rule" model="ir.rule">
            <field name="name">legal.knowledge.document: multi-company</field>
            <field name="model_id" ref="model_legal_knowledge_document"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="legal_ingestion_run_company_rule" model="ir.rule">
            <field name="name">legal.ingestion.run: multi-company</field>
            <field name="model_id" ref="model_legal_ingestion_run"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
